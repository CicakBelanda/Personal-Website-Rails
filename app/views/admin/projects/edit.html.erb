<h1 class="admin-title">Edit Project</h1>
<%= form_with model: @project, url: admin_project_path(@project.id), method: :patch, local: true, class: "admin-form" do |form| %>
  <fieldset class="admin-group">
    <legend class="admin-group__legend">Basic Information</legend>
    <%= render "admin/shared/form_fields", form: form, record: @project, columns: ["title", "short_description", "description", "category", "category_label", "role", "location", "client", "status", "project_date"] %>
  </fieldset>

  <fieldset class="admin-group">
    <legend class="admin-group__legend">Technical</legend>
    <%= render "admin/shared/form_fields", form: form, record: @project, columns: ["tech_stack", "tech_details", "key_features"] %>
  </fieldset>

  <fieldset class="admin-group">
    <legend class="admin-group__legend">Case Study</legend>
    <%= render "admin/shared/form_fields", form: form, record: @project, columns: ["problem", "solution", "metrics"] %>
  </fieldset>

  <fieldset class="admin-group">
    <legend class="admin-group__legend">Media</legend>
    <div class="admin-field">
      <%= form.label :cover_image, "Cover Image" %>
      <% if @project.cover_image.attached? %>
        <div class="admin-current-media">
          <%= image_tag @project.cover_image, class: "admin-thumb", alt: "" %>
          <label class="admin-check"><%= form.check_box :cover_image_remove %> Remove current cover</label>
        </div>
      <% end %>
      <%= form.file_field :cover_image, accept: "image/*", class: "admin-input" %>
      <p class="admin-hint">Upload an image from your device (replaces the current cover).</p>
    </div>

    <div class="admin-field">
      <%= form.label :gallery_images, "Gallery Images" %>
      <% if @project.gallery_images.attached? %>
        <div class="admin-current-media admin-current-media--row">
          <% @project.gallery_images.each do |img| %>
            <%= image_tag img, class: "admin-thumb", alt: "" %>
          <% end %>
        </div>
      <% end %>
      <%= form.file_field :gallery_images, accept: "image/*", multiple: true, class: "admin-input" %>
      <p class="admin-hint">Upload one or more images from your device (added to the gallery).</p>
      <% if @project.gallery_images.attached? %>
        <label class="admin-check"><%= form.check_box :gallery_images_remove %> Remove all gallery images</label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="admin-group">
    <legend class="admin-group__legend">Links</legend>
    <%= render "admin/shared/form_fields", form: form, record: @project, columns: ["github_url", "demo_url"] %>
  </fieldset>

  <fieldset class="admin-group">
    <legend class="admin-group__legend">Publishing</legend>
    <%= render "admin/shared/form_fields", form: form, record: @project, columns: ["featured", "position"] %>
  </fieldset>

  <div class="admin-form__actions">
    <%= form.submit "Save", class: "admin-btn admin-btn--primary" %>
    <%= link_to "Cancel", admin_projects_path, class: "admin-link" %>
  </div>
<% end %>
