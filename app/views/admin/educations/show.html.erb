<h1 class="admin-title"><%= @education.send("school") %></h1>
<dl class="admin-show">
  <% @education.attributes.except("id", "created_at", "updated_at").each do |k, v| %>
    <dt><%= k.titleize %></dt>
    <dd><%= v.is_a?(Array) ? v.join(", ") : v.to_s %></dd>
  <% end %>
</dl>
<div class="admin-form__actions">
  <%= link_to "Edit", edit_admin_education_path(@education.id), class: "admin-btn" %>
  <%= link_to "Back", admin_educations_path, class: "admin-link" %>
</div>
