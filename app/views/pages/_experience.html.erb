<section id="experience" class="section experience reveal">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">// Experience</span>
      <h2 class="section__title">Where I've worked</h2>
    </div>

    <ol class="timeline">
      <% @experiences.each do |exp| %>
        <li class="timeline__item">
          <div class="timeline__marker" aria-hidden="true"></div>
          <div class="timeline__card">
            <div class="timeline__row">
              <div>
                <h3 class="timeline__role"><%= exp.title %></h3>
                <p class="timeline__org"><%= exp.organization %></p>
              </div>
              <span class="timeline__date">
                <%= exp.start_date %><% if exp.end_date.present? %> – <%= exp.end_date %><% end %>
              </span>
            </div>
            <% if exp.highlights.any? %>
              <ul class="timeline__highlights">
                <% exp.highlights.each do |h| %>
                  <li><%= h %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
