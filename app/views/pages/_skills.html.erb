<section id="skills" class="section skills reveal">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">Toolkit</span>
      <h2 class="section__title">Skills &amp; Technologies</h2>
      <p class="skills__hint">Explore the technologies behind my projects.</p>
    </div>

    <div class="skills-map" data-controller="skills"
         data-action="keydown.esc->skills#reset"
         data-skills-active-value="">

      <% @skills_map.each do |disc| %>
        <div class="skill-branch" data-skill-branch data-discipline="<%= disc[:id] %>">
          <button type="button" class="skill-discipline" data-skill-discipline
                  data-action="click->skills#toggle mouseenter->skills#activate focus->skills#activate"
                  aria-expanded="false"
                  aria-controls="skill-tech-<%= disc[:id] %>">
            <span class="skill-discipline__index" aria-hidden="true">0<%= @skills_map.index(disc) + 1 %></span>
            <span class="skill-discipline__body">
              <span class="skill-discipline__title"><%= disc[:title] %></span>
              <span class="skill-discipline__blurb"><%= disc[:blurb] %></span>
            </span>
            <span class="skill-discipline__rule" aria-hidden="true"></span>
            <span class="skill-discipline__count"><%= disc[:techs].length %> technologies</span>
            <span class="skill-discipline__chev" aria-hidden="true"></span>
          </button>

          <div class="skill-techs" id="skill-tech-<%= disc[:id] %>"
               data-skill-techs data-discipline="<%= disc[:id] %>" hidden>
            <% disc[:techs].each do |t| %>
              <button type="button" class="skill-tech" data-skill-tech
                      data-action="mouseenter->skills#showTech click->skills#showTech focus->skills#showTech"
                      data-name="<%= t[:name] %>"
                      data-desc="<%= t[:desc] %>"
                      data-projects="<%= t[:projects].to_json %>"
                      aria-describedby="skill-detail">
                <span class="skill-tech__dot" aria-hidden="true"></span>
                <span class="skill-tech__name"><%= t[:name] %></span>
                <% if t[:projects].any? %>
                  <span class="skill-tech__used"><%= t[:projects].length %></span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="skill-extra">
        <span class="skill-extra__label">Additional technologies</span>
        <div class="skill-extra__row">
          <% @skills_extra.each do |t| %>
            <button type="button" class="skill-tech skill-tech--extra" data-skill-tech
                    data-action="mouseenter->skills#showTech click->skills#showTech focus->skills#showTech"
                    data-name="<%= t[:name] %>"
                    data-desc="<%= t[:desc] %>"
                    data-projects="<%= [].to_json %>"
                    aria-describedby="skill-detail">
              <span class="skill-tech__dot" aria-hidden="true"></span>
              <span class="skill-tech__name"><%= t[:name] %></span>
            </button>
          <% end %>
        </div>
      </div>

      <aside class="skill-detail" id="skill-detail" data-skills-target="detail"
             aria-live="polite" data-skill-detail>
        <div class="skill-detail__inner" data-skill-detail-empty>
          <p class="skill-detail__placeholder">Select a technology to see how it is used.</p>
        </div>
      </aside>
    </div>
  </div>
</section>
