<section id="projects" class="section projects reveal">
  <div class="container">
    <div class="section__head">
      <span class="eyebrow">Work</span>
      <h2 class="section__title">Featured Projects</h2>
      <p class="section__sub">Selected work across native iOS, machine learning, and data science.</p>
    </div>

    <div class="projects__grid projects__grid--featured">
      <% @featured_projects.each do |project| %>
        <%= render "pages/project_card", project: project, variant: "featured" %>
      <% end %>
    </div>

    <% if @other_projects.any? %>
      <div class="projects__other">
        <div class="projects__other-head">
          <h3 class="projects__other-title">Other Projects</h3>
          <span class="projects__other-rule" aria-hidden="true"></span>
        </div>
        <div class="projects__grid projects__grid--other">
          <% @other_projects.each do |project| %>
            <%= render "pages/project_card", project: project, variant: "other" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
