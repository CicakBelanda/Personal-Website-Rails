<section class="hero">
  <div class="container">
    <div class="hero__avatar">KJ</div>
    <h1 class="hero__title">
      Hi, I'm <span class="gradient-text">Kevin J</span>
    </h1>
    <p class="hero__subtitle">
      I build things at the intersection of mobile, data and the web.
    </p>
    <div class="hero__roles">
      <span class="hero__role">iOS Developer</span>
      <span class="hero__role">Data Scientist</span>
      <span class="hero__role">Software Engineer</span>
    </div>
    <div class="hero__cta">
      <a href="#projects" class="btn btn-primary">View Projects</a>
      <a href="files/resume.pdf" class="btn btn-secondary">Download Resume</a>
      <a href="#contact" class="btn btn-outline">Get in Touch</a>
    </div>
  </div>
</section>

<%= render "shared/navbar" %>
<%= render "pages/about" %>
<%= render "pages/skills" %>
<%= render "pages/projects" %>
<%= render "pages/contact" %>
<%= render "shared/footer" %>