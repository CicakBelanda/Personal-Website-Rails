<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Kevin Joseph Handoyo — iOS Developer · ML Engineer · Data Scientist" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#050505">
    <%= favicon_link_tag "kevin.png", type: "image/png", sizes: "512x512" %>
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="description" content="Kevin J — iOS Developer, Data Scientist and Software Engineer. Portfolio of projects across mobile, machine learning and web.">
    <%= render "shared/seo" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Devicon: brand logo glyphs for skill chips (placeholder fallback when a logo is missing) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicon/devicon@latest/devicon.min.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="nav-active reveal cursor">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="cursor-ring" data-cursor-target="ring" aria-hidden="true"></div>
    <div class="cursor-dot" data-cursor-target="dot" aria-hidden="true"></div>
    <% flash.each do |type, message| %>
      <div id="flash" class="flash-<%= type %>">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
