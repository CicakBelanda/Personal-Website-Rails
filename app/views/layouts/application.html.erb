<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Kevin J — Developer, Data Scientist & Engineer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#6366f1">
    <meta name="description" content="Kevin J — iOS Developer, Data Scientist and Software Engineer. Portfolio of projects across mobile, machine learning and web.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="nav-active reveal">
    <% flash.each do |type, message| %>
      <div id="flash" class="flash-<%= type %>">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
